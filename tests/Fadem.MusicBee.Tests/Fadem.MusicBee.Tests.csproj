<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The plugin's runtime: 32-bit .NET Framework 4.8, as MusicBee loads it (ADR 0012). -->
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fadem.MusicBee\Fadem.MusicBee.csproj" />
    <!-- The fake output, the WAV writers and TestTemp live with the Core tests. -->
    <ProjectReference Include="..\Fadem.Core.Tests\Fadem.Core.Tests.csproj" />
  </ItemGroup>

</Project>
