<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48 x86 is the MusicBee plugin's runtime (phase 5, ADR 0012): the promise is proven
         there too. -->
    <TargetFrameworks>net8.0;net48</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The assembly is its own child process: ChildProcess.Main (build issue 21). -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Faderio.Core\Faderio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- net48 x86 compiles the promise and the file formats only, until the whole suite follows
       ("Core multi-targeted in full"). A test left out here is excluded, never skipped. Tests
       built on ChildProcess stay net8.0-only: it starts children through dotnet. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Compile Remove="**\*.cs" />
    <Compile Include="PluginRuntimeTests.cs" />
    <!-- helpers -->
    <Compile Include="CraftedMp3.cs;FakeAudioOutput.cs;TestAudio.cs;TestEngine.cs;TestTemp.cs" />
    <!-- the promise -->
    <Compile Include="RealInputMatrixTests.cs;FadeEngineAccuracyTests.cs" />
    <!-- atomic writes, the store, the settings files and the folder scan -->
    <Compile Include="AtomicWriteTests.cs;FileFormatTests.cs;FolderScanTests.cs" />
    <Compile Include="JsonTransitionStoreTests.cs;SettingsStoreTests.cs;MachineSettingsTests.cs;StoreFailureTests.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <Compile Remove="PluginRuntimeTests.cs" />
  </ItemGroup>

</Project>
