<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A MusicBee plugin of type General (phase 5, ADR 0012): MusicBee is 32-bit .NET Framework
         4.8, and loads Plugins\mb_*.dll, looking for the class MusicBeePlugin.Plugin. -->
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>mb_fadem</AssemblyName>
    <RootNamespace>Fadem.MusicBee</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fadem.Core\Fadem.Core.csproj" />
    <ProjectReference Include="..\Fadem.Shell\Fadem.Shell.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fadem.MusicBee.Tests" />
  </ItemGroup>

  <!-- What is copied into MusicBee's Plugins folder: the plugin beside a private fadem\ folder
       of everything it depends on, which its assembly-resolve handler loads (it has no binding
       redirects of its own). The dependencies come from what this build resolved, not a glob of
       the output folder, so a DLL left there by an older build (such as mb_faderio.dll from
       before ADR 0018) is never shipped. -->
  <Target Name="PluginLayout" AfterTargets="Build">
    <ItemGroup>
      <PluginDependency Include="@(ReferenceCopyLocalPaths)"
                        Condition="'%(Extension)' == '.dll' And '%(ReferenceCopyLocalPaths.DestinationSubDirectory)' == ''" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)plugin" />
    <Copy SourceFiles="$(OutDir)$(TargetFileName)" DestinationFolder="$(OutDir)plugin" />
    <Copy SourceFiles="@(PluginDependency)" DestinationFolder="$(OutDir)plugin\fadem" />
  </Target>

</Project>
