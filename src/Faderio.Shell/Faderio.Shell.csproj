<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- What both hosts share: standalone faderio (net8.0-windows) and the MusicBee plugin
         (net48, ADR 0012). The output, the Presenter, and the controls both hosts compose:
         the transition editor panel, the transition manager, the playlist sidebar and the seek
         bar (phase 5 issue 09). MainForm and Program stay standalone-only. -->
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Faderio.Core\Faderio.Core.csproj" />
  </ItemGroup>

  <!-- Each target compiles its own Compat folder: the WinForms members net48 lacks, and what
       net8.0-windows already has. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <Compile Remove="Compat/Net48/**" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Compile Remove="Compat/Net8/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The hosts compose the controls, and their tests reach them (ADR 0002, S5). -->
    <InternalsVisibleTo Include="faderio" /> <!-- the App: its assembly is named faderio -->
    <InternalsVisibleTo Include="Faderio.App.Tests" />
    <InternalsVisibleTo Include="Faderio.Shell.Tests" />
    <InternalsVisibleTo Include="Faderio.MusicBee" />
    <!-- The output's player factory: the plugin's tests stand a fake player in for NAudio's. -->
    <InternalsVisibleTo Include="Faderio.MusicBee.Tests" />
  </ItemGroup>

</Project>
